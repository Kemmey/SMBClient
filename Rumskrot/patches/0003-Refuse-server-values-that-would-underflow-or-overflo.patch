From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kim Hansen <github@kimhansen.dk>
Date: Sat, 17 Oct 2026 15:16:38 +0200
Subject: [PATCH] Refuse server values that would underflow or overflow client
 arithmetic

A NEGOTIATE reply with a zero maxTransactSize, maxReadSize or
maxWriteSize is refused (creditSize(0) underflowed, and a zero write
size never advanced an upload); creditSize itself no longer underflows
on zero. A READ reply carrying more bytes than were asked for is refused
before FileReader's remaining-length arithmetic can underflow. An NTLM
challenge whose target info cannot fit in the 16-bit length of the NT
challenge response that echoes it is refused instead of trapping in
UInt16(_:).

RUMSKROT-HARDEN 3/5

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013Swhv8UXni3MZr9Kcar7wJ
---
 Sources/SMBClient/Auth/NTLM.swift |  5 +++++
 Sources/SMBClient/Session.swift   | 22 ++++++++++++++++++++--
 2 files changed, 25 insertions(+), 2 deletions(-)

diff --git a/Sources/SMBClient/Auth/NTLM.swift b/Sources/SMBClient/Auth/NTLM.swift
index 000b1aa..a67ddff 100644
--- a/Sources/SMBClient/Auth/NTLM.swift
+++ b/Sources/SMBClient/Auth/NTLM.swift
@@ -104,6 +104,11 @@ public enum NTLM {
       version = try reader.read()
       targetName = try reader.read(from: Int(targetNameBufferOffset), count: Int(targetNameLen))
       targetInfo = try reader.read(from: Int(targetInfoBufferOffset), count: Int(targetInfoLen))
+      // RUMSKROT-HARDEN: the target info is echoed inside the NT challenge
+      // response (52 bytes of its own), whose length field is 16 bits.
+      guard targetInfo.count <= Int(UInt16.max) - 52 else {
+        throw ResponseDecodingError.invalidValue(field: "ChallengeMessage.targetInfoLen", value: UInt64(targetInfoLen))
+      }
 
       buffer = data
     }
diff --git a/Sources/SMBClient/Session.swift b/Sources/SMBClient/Session.swift
index a6fa156..d9dd91a 100644
--- a/Sources/SMBClient/Session.swift
+++ b/Sources/SMBClient/Session.swift
@@ -79,6 +79,16 @@ public class Session {
 
     let response = try await send(request)
 
+    // RUMSKROT-HARDEN: every read, write and listing is sized from these;
+    // zero would underflow the credit arithmetic or never make progress.
+    for (field, value) in [
+      ("maxTransactSize", response.maxTransactSize),
+      ("maxReadSize", response.maxReadSize),
+      ("maxWriteSize", response.maxWriteSize),
+    ] where value == 0 {
+      throw ResponseDecodingError.invalidValue(field: "Negotiate.\(field)", value: UInt64(value))
+    }
+
     signingRequired = response.securityMode.contains(.signingRequired) || (securityMode.contains(.signingRequired) && response.securityMode.contains(.signingEnabled))
 
     maxTransactSize = response.maxTransactSize
@@ -272,7 +282,13 @@ public class Session {
       length: readSize
     )
 
-    return try await send(request)
+    let response = try await send(request)
+    // RUMSKROT-HARDEN: a reply longer than the read asked for would
+    // underflow every caller's remaining-length arithmetic.
+    guard response.buffer.count <= Int(readSize) else {
+      throw ResponseDecodingError.invalidValue(field: "Read.dataLength", value: UInt64(response.buffer.count))
+    }
+    return response
   }
 
   @discardableResult
@@ -824,5 +840,7 @@ private class SequenceNumber<I: UnsignedInteger & FixedWidthInteger> {
 }
 
 private func creditSize(size: UInt32) -> UInt16 {
-  UInt16(truncatingIfNeeded: (size - 1) / 65536 + 1)
+  // RUMSKROT-HARDEN: a zero size still costs one credit, not an underflow.
+  guard size > 0 else { return 1 }
+  return UInt16(truncatingIfNeeded: (size - 1) / 65536 + 1)
 }
